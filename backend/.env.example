# Public URL of the Next.js site (magic links, WebAuthn origin and OAuth redirects use it)
APP_URL=http://localhost:3100
APP_ENV=development

# Mail: "log" writes emails to storage/mail.log (dev), "mail" uses PHP mail()
MAIL_DRIVER=log
MAIL_FROM="SwapS.ng <no-reply@swaps.ng>"

# Google sign-in (https://console.cloud.google.com/apis/credentials)
# Authorised redirect URI: ${APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
